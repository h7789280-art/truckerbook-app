VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
GOOGLE_API_KEY=your_google_api_key_here
N8N_API_URL=https://etariahubpro.app.n8n.cloud/api/v1
N8N_API_KEY=your_n8n_api_key_here

# Gemini (used by Smart Scan, odometer reader, and AI Deduction Audit)
VITE_GEMINI_API_KEY=your_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# Closed-beta SMS bypass (api/auth/test-bypass).
# Set to 'true' ONLY in environments where whitelisted test phones from the
# test_users table should skip Twilio. Anything else (including unset) makes
# the endpoint return 403 — the production-safe default. See CLAUDE.md.
ENABLE_TEST_USER_BYPASS=false
